API_IMAGE=destiny2report-api:latest

# Keep this on loopback when a reverse proxy runs on the same host.
API_BIND_ADDRESS=127.0.0.1
API_PORT=8080

BUNGIE_API_KEY=replace-me
BUNGIE_CLIENT_ID=replace-me
BUNGIE_CLIENT_SECRET=replace-me

# Use URL-safe values because these credentials are embedded in the MongoDB URI.
MONGO_USERNAME=destiny2report
MONGO_PASSWORD=replace-with-a-url-safe-password
REDIS_PASSWORD=replace-with-a-strong-password

# Point this at your production collector, Jaeger, or observability platform.
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.com:4317
OTEL_EXPORTER_OTLP_PROTOCOL=Grpc
