API_IMAGE=destiny2report-api:latest

# Keep this on loopback when a reverse proxy runs on the same host.
API_BIND_ADDRESS=127.0.0.1
API_PORT=8080

BUNGIE_API_KEY=replace-me
BUNGIE_CLIENT_ID=replace-me
BUNGIE_CLIENT_SECRET=replace-me
ADMIN_MEMBERSHIP_TYPE_ID=replace-me
ADMIN_MEMBERSHIP_ID=replace-me

# Generate this key pair once with:
# dotnet run --project Destiny2Report.API -- --generate-vapid-keys
WEB_PUSH_SUBJECT=mailto:admin@example.com
WEB_PUSH_PUBLIC_KEY=replace-with-generated-public-key
WEB_PUSH_PRIVATE_KEY=replace-with-generated-private-key

# Use URL-safe values because these credentials are embedded in the MongoDB URI.
MONGO_USERNAME=destiny2report
MONGO_PASSWORD=replace-with-a-url-safe-password
# Generate once with: mkdir -p secrets && openssl rand -base64 756 > secrets/mongo-keyfile && chmod 400 secrets/mongo-keyfile
MONGO_REPLICA_SET_KEY_FILE=./secrets/mongo-keyfile
REDIS_PASSWORD=replace-with-a-strong-password

# Point this at your production collector, Jaeger, or observability platform.
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.com:4317
OTEL_EXPORTER_OTLP_PROTOCOL=Grpc
# Optional. When set, both the API and Rust crawler send Authorization: Bearer <value>.
OTEL_EXPORTER_OTLP_BEARER_TOKEN=
RUST_CRAWLER_OTEL_SERVICE_NAME=Destiny2Report.Crawler
