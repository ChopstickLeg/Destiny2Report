# Copy to .env.local for local development overrides.

# API base path used by the fetch client (defaults to same-origin /api).
#VITE_API_BASE_URL=/api

# Dev-only: where the Vite dev server proxies /api requests.
#VITE_DEV_API_PROXY=http://localhost:5063

# Bungie OAuth (sign-in stays hidden until a client id is provided).
#VITE_BUNGIE_CLIENT_ID=
#VITE_BUNGIE_AUTHORIZE_URL=https://www.bungie.net/en/OAuth/Authorize

# Cloudflare Turnstile sitekey used before every report queue request. Local
# development falls back to Cloudflare's official always-pass test sitekey.
#VITE_TURNSTILE_SITE_KEY=

# Optional trusted HTTPS for local OAuth callbacks. Export a localhost PFX with
# `dotnet dev-certs https`, then keep its password in the ignored .env.local.
#DEV_HTTPS_PFX_PATH=C:/Users/you/.aspnet/https/destiny2report-ui.pfx
#DEV_HTTPS_PFX_PASSWORD=
